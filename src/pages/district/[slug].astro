---
import Base from '../../layouts/Base.astro';
import '../../styles/global.css';
import solan from '../../data/solan.json';

const districts = [solan];
export function getStaticPaths() {
  return districts.map(d => ({ params: { slug: d.district.slug }, props: { d } }));
}
const { d } = Astro.props;
const { district, villages, pincodes } = d;

const byTehsil = {};
for (const v of villages) {
  (byTehsil[v.tehsil] ||= []).push(v);
}
const tehsils = Object.keys(byTehsil).sort();
const letters = [...new Set(villages.map(v => v.name[0].toUpperCase()).filter(c => /[A-Z]/.test(c)))].sort();
const pinCount = new Set(villages.map(v => v.pincode).filter(Boolean)).size;
---
<Base
  title={`Villages and pincodes in ${district.name} district, ${district.state} — full list`}
  description={`All ${villages.length} villages and ${pincodes.length} post offices in ${district.name} district, ${district.state}. Find the pincode, tehsil and post office for any village.`}
>
  <section class="wrap pt-8 pb-6">
    <nav class="text-xs mute mb-3"><a href="/">Home</a> / {district.state} / {district.name}</nav>
    <h1 class="text-2xl md:text-4xl font-bold tracking-tight">
      Villages and pincodes in {district.name} district
    </h1>
    <p class="mt-3 mute text-sm leading-relaxed">
      {district.name} district in {district.state} has <b>{villages.length}</b> mapped villages across
      <b>{tehsils.length}</b> tehsils and <b>{pincodes.length}</b> post offices, covering
      <b>{pinCount}</b> distinct pincodes. Every village below is listed with its tehsil and pincode —
      use the A–Z jump bar or the filter box to find one fast.
    </p>
  </section>

  <section class="wrap pb-8">
    <div class="card p-4">
      <div class="az flex flex-wrap">{letters.map(l => <a href={`#L-${l}`}>{l}</a>)}</div>
      <input id="vf" type="search" placeholder="Filter villages by name or pincode…"
        class="mt-3 w-full px-3 py-2 rounded-lg text-sm"
        style="background:#0f1829;border:1px solid var(--color-line);color:#e8eefc" />
      <p class="text-xs mute mt-2"><span id="cnt">{villages.length}</span> villages shown</p>
    </div>
  </section>

  <section class="wrap pb-16">
    {tehsils.map(t => (
      <details open>
        <summary>{t} tehsil — {byTehsil[t].length} villages</summary>
        <div class="vgrid">
          {byTehsil[t].map(v => (
            <a href={`#v-${v.slug}`} id={`v-${v.slug}`} data-n={`${v.name.toLowerCase()} ${v.pincode||''}`}>
              <span id={`L-${v.name[0].toUpperCase()}`}></span>
              {v.name} <span class="mute">· {v.pincode || 'no pincode'}</span>
            </a>
          ))}
        </div>
      </details>
    ))}
  </section>

  <section class="wrap pb-16">
    <h2 class="text-xl font-semibold mb-3">Post offices in {district.name}</h2>
    <div class="card p-4">
      <div class="vgrid">
        {pincodes.map(p => (
          <div style="font-size:.86rem">
            <b>{p.pincode}</b> · {p.office_name} <span class="mute">({p.office_type}, {p.delivery})</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const inp = document.getElementById('vf') as HTMLInputElement | null;
    const cnt = document.getElementById('cnt');
    if (inp) {
      inp.addEventListener('input', () => {
        const q = inp.value.trim().toLowerCase();
        let shown = 0;
        document.querySelectorAll('.vgrid a').forEach((el) => {
          const hit = !q || (el.getAttribute('data-n') || '').includes(q);
          (el as HTMLElement).style.display = hit ? '' : 'none';
          if (hit) shown++;
        });
        if (cnt) cnt.textContent = String(shown);
      });
    }
  </script>
</Base>
