---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
const options = [
  { t: 'Send a parcel', d: 'Find the exact pincode and post office for a delivery address.', href: '/district/solan/' },
  { t: 'Find my pincode', d: 'Look up a pincode, its post office and the villages it serves.', href: '/district/solan/' },
  { t: 'Verify an address', d: 'Check which villages and tehsils a pincode actually covers.', href: '/district/solan/' },
  { t: 'Post office info', d: 'Delivery type, taluk, division and the villages served.', href: '/district/solan/' },
];
---
<Base title="Digipincode — static preview" description="Preview of the static district-page build: villages, pincodes and post offices in one page.">
  <section class="wrap pt-8 pb-10">
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight">What are you doing?</h1>
    <p class="mt-3 mute">One page per district. Every village, every pincode — no waiting, no database call.</p>
    <div class="grid gap-3 md:grid-cols-2 mt-8">
      {options.map(o => (
        <a href={o.href} class="card p-5 block hover:border-sky-400/50">
          <div class="font-semibold">{o.t}</div>
          <div class="text-sm mute mt-1">{o.d}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
